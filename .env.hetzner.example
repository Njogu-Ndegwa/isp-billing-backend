# Pass this file explicitly: docker compose --env-file .env.hetzner ...
# Never commit the populated .env.hetzner file.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=isp_billing_db
POSTGRES_USER=isp_user
POSTGRES_PASSWORD=change-me-random-database-password
DATABASE_URL=postgresql+asyncpg://isp_user:change-me-random-database-password@db:5432/isp_billing_db

SECRET_KEY=change-me-to-the-current-production-jwt-secret
SHADOW_MODE=false
SCHEDULER_ENABLED=false
SMS_DISPATCH_ENABLED=false
MPESA_B2B_DAILY_PAYOUT_ENABLED=false
FEEDBACK_AI_ENABLED=false

SERVER_PUBLIC_IP=91.98.238.12
WG_MANAGER_URL=http://host.docker.internal:8730
WG_MANAGER_SECRET=change-me-to-the-existing-wg2-manager-secret
WG_INTERFACE=wg2
L2TP_IPSEC_PSK=change-me-to-the-existing-hetzner-l2tp-psk
RADIUS_SHARED_SECRET=change-me-to-the-current-radius-secret
ROUTER_REMOTE_ACCESS_SOURCE_CIDRS=10.251.0.1/32

PROVISION_BASE_URL=https://isp.bitwavetechnologies.net
PROVISION_LEGACY_BASE_URL=http://isp.bitwavetechnologies.net

# Keep the secondary tunnel settings pointed at Hetzner during rehearsal. They
# are already idempotent on routers and use the existing wg2 manager.
INSURANCE_WG_MANAGER_URL=http://host.docker.internal:8730
INSURANCE_WG_MANAGER_SECRET=change-me-to-the-existing-wg2-manager-secret
INSURANCE_SERVER_PUBLIC_IP=91.98.238.12
INSURANCE_SERVER_VPN_IP=10.251.0.1
INSURANCE_WG_PORT=51823
INSURANCE_ROUTER_INTERFACE=wg-hz
INSURANCE_WG_SUBNET=10.251.0.0/16
INSURANCE_L2TP_INTERFACE=l2tp-aws2
INSURANCE_L2TP_IPSEC_PSK=change-me-to-the-existing-hetzner-l2tp-psk

# Copy the remaining provider, messaging, email, and payment settings from the
# current production container without printing them. Keep dispatch/schedulers
# disabled above until final traffic ownership is transferred.
MPESA_CONSUMER_KEY=change-me
MPESA_CONSUMER_SECRET=change-me
MPESA_SHORTCODE=change-me
MPESA_PASSKEY=change-me
MPESA_CALLBACK_URL=https://isp.bitwavetechnologies.net/api/mpesa/callback
MPESA_ENVIRONMENT=production
