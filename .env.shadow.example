# Copy to .env.shadow on the target and replace every change-me value.
# Never commit the populated file.
POSTGRES_DB=isp_billing_shadow
POSTGRES_USER=isp_shadow
POSTGRES_PASSWORD=change-me-random-database-password
DATABASE_URL=postgresql+asyncpg://isp_shadow:change-me-random-database-password@shadow-db:5432/isp_billing_shadow
SECRET_KEY=change-me-to-the-production-jwt-secret-for-login-validation
SHADOW_MODE=true
SMS_DISPATCH_ENABLED=false
MPESA_B2B_DAILY_PAYOUT_ENABLED=false
MPESA_CONSUMER_KEY=shadow-disabled
MPESA_CONSUMER_SECRET=shadow-disabled
MPESA_SHORTCODE=shadow-disabled
MPESA_PASSKEY=shadow-disabled
MPESA_CALLBACK_URL=http://127.0.0.1/shadow-disabled
MPESA_ENVIRONMENT=sandbox
