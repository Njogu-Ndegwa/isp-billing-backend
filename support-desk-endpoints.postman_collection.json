{
  "info": {
    "name": "Support desk snapshot",
    "description": "WhatsApp support desk snapshot. POST is the laptop ingest (machine token SUPPORT_DESK_INGEST_TOKEN); GET is platform admin (role admin) only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8000"},
    {"key": "adminToken", "value": ""},
    {"key": "supportDeskIngestToken", "value": ""}
  ],
  "item": [
    {
      "name": "Push snapshot (laptop)",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{supportDeskIngestToken}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"generated_at\": \"2026-10-23T11:45:20+00:00\",\n  \"customers\": {\"rows\": []},\n  \"worklog\": {\"entries\": []}\n}"
        },
        "url": "{{baseUrl}}/api/admin/support-desk/snapshot",
        "description": "200 {received_at,size_bytes,sha256,masked}. 401 bad/missing token, 413 over 2 MB, 400 not a JSON object, 503 SUPPORT_DESK_INGEST_TOKEN unset."
      }
    },
    {
      "name": "Get latest snapshot (platform admin)",
      "request": {
        "method": "GET",
        "header": [
          {"key": "Authorization", "value": "Bearer {{adminToken}}"}
        ],
        "url": "{{baseUrl}}/api/admin/support-desk",
        "description": "200 {received_at,size_bytes,sha256,snapshot}. 403 for resellers and View-as sessions, 404 before the first push."
      }
    }
  ]
}
